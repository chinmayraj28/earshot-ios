# Used by index.html while running `vite` for development only. Vite's live reload needs an
# inline script, inline styles and a websocket back to the dev server, so this is looser than
# .env.production. It still blocks every other website.
VITE_CSP="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws://localhost:* ws://127.0.0.1:*; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
