# Used by index.html as the Content-Security-Policy of the built app.
# Only files from this site may load. No inline scripts or styles, no plugins, no outside connections.
VITE_CSP="default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'none'; object-src 'none'"
